// Phase 1: Zero Register (x0) Hardwiring & Invariance
00a00093  // addi x0, x0, 10      (Attempt write to x0; x0 must remain 0)
000000b3  // add  x1, x0, x0      (x1 = x0 + x0 -> x1 = 0)
000000ef  // jal  x0, 0           (Jump to self + 0 using x0 link reg; must not corrupt x0)

// Phase 2: Shift Lower-5-Bit Masking & Max Values
00100113  // addi x2, x0, 1       (x2 = 1)
02000193  // addi x3, x0, 32      (x3 = 32; lower 5 bits = 0b00000 -> shift by 0)
00311233  // sll  x4, x2, x3      (x4 = 1 << 0 = 1)
02100193  // addi x3, x0, 33      (x3 = 33; lower 5 bits = 0b00001 -> shift by 1)
003112b3  // sll  x5, x2, x3      (x5 = 1 << 1 = 2)

// Phase 3: Signed Wraparound
7ffff337  // lui  x6, 0x7ffff    (x6 = 0x7ffff000)
7ff30313  // addi x6, x6, 2047    (x6 = 0x7fffffff -> max positive signed int)
00130393  // addi x7, x6, 1       (x7 = 0x80000000 -> wraparound to min negative signed int)

// Phase 4: Sub-word Memory Writes (SB / SH)
deadb437  // lui  x8, 0xdeadb
eef40413  // addi x8, x8, -273    (x8 = 0xdeadbeef)
00802023  // sw   x8, 0(x0)       (Mem[0] = 0xdeadbeef)
0ff00493  // addi x9, x0, 255     (x9 = 0x000000ff)
009000a3  // sb   x9, 1(x0)       (Mem[1] = 0xff; Mem[0] becomes 0xdeadffef)

// Phase 5: Sub-word Memory Loads (LB / LBU / LH / LHU)
00000503  // lb   x10, 0(x0)      (Load byte at 0 -> 0xef -> sign-extended x10 = 0xffffffef)
00004583  // lbu  x11, 0(x0)      (Load byte at 0 -> 0xef -> zero-extended x11 = 0x000000ef)
00201603  // lh   x12, 2(x0)      (Load half at 2 -> 0xdead -> sign-extended x12 = 0xffffdead)
00205683  // lhu  x13, 2(x0)      (Load half at 2 -> 0xdead -> zero-extended x13 = 0x0000dead)
00002703  // lw   x14, 0(x0)      (Load word at 0 -> read back full modified word 0xdeadffef)

// Phase 6: Negative Memory Base Offsets
01000793  // addi x15, x0, 16     (Base ptr x15 = 16)
0087aebd  // sw   x8, -4(x15)     (Mem[16 - 4 = 12] = 0xdeadbeef)
0fc7a803  // lw   x16, -4(x15)    (Load from Mem[12] -> x16 = 0xdeadbeef)

// Phase 7: Backward Loop Branching
00300893  // addi x17, x0, 3      (Loop counter = 3)
fff88893  // addi x17, x17, -1    (Loop start: x17--)
fe089ce3  // bne  x17, x0, -8     (Branch back to loop start if x17 != 0)

// Phase 8: Subroutine Link Jump Pair (JAL + JALR)
00c009ef  // jal  x19, 12         (Jump forward 12 bytes to PC+12, x19 = return PC)
00000013  // nop                  (Skipped)
00000013  // nop                  (Skipped)
000980e7  // jalr x0, 0(x19)      (Jump back using return link in x19)